{
  "name": "specloop-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice-first I&C learning MVP: narrated lessons, retrieval quizzes, scenarios, and spaced review.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "seed:import": "node --experimental-strip-types scripts/import-seed.mts",
    "seed:sql": "UPDATE_SEED_SQL=1 vitest run src/lib/seed/seed-sql.test.ts",
    "test:e2e:hosted": "playwright test -c playwright.hosted.config.ts",
    "verify:rls": "node scripts/verify-rls.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
