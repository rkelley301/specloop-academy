# SpecLoop Academy — environment configuration.
# Copy to .env.local and fill in only what you use. Every integration is OFF
# unless its variables are set. Never commit real values.

# --- AI lesson drafting (optional) ---------------------------------------
# Set AI_PROVIDER=anthropic and an API key to enable "Draft with AI".
# Learners must still click an explicit consent button before any source text
# is sent. Leave blank for deterministic template drafts (no network calls).
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# --- OneStudio text-to-speech (not implemented) ----------------------------
# Direct generation is disabled until a verified OneStudio API is documented.
# See docs/onestudio-integration.md for what is needed. These are placeholders
# reserved for that adapter; setting them today does nothing.
ONESTUDIO_API_BASE_URL=
ONESTUDIO_API_KEY=

# --- Supabase hosted backend (schema provided, adapter not wired) -----------
# See supabase/migrations/0001_init.sql. The app runs in local demo mode
# regardless of these values in this release.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Stripe billing (disabled) --------------------------------------------
# Payments are disabled in this build. A test-mode adapter would read these.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
